{{!
    @template theme_boost/navbar-secure

    Ivana Academy: navbar of the secure layout (policies before sign up, safe exam pages).
    Only the landing pages logo, no navigation, as in core.

    Example context (json):
    {
        "sitename": "Ivana Academy",
        "output": {
            "get_logo": "http://example.com/logo.svg",
            "secure_layout_language_menu": "",
            "secure_layout_login_info": ""
        }
    }
}}
<nav class="navbar fixed-top ivana-lp-navbar ivana-secure-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="ivana-lp-navbar-inner">
        <div class="ivana-lp-brand">
            <img src="{{output.get_logo}}" alt="{{sitename}}" class="ivana-lp-logo" width="190" height="48">
        </div>

        <div class="ivana-lp-right">
            {{# output.secure_layout_language_menu }}
                <ul class="nav navbar-nav language-menu my-1">
                    {{{ . }}}
                </ul>
            {{/ output.secure_layout_language_menu }}

            {{# output.secure_layout_login_info }}
                <div class="nav-link">
                    {{{ . }}}
                </div>
            {{/ output.secure_layout_login_info }}
        </div>
    </div>
</nav>
