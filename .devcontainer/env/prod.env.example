# /home/admin/devcontainer/env/prod.env (VPS, fora do git) - lido por
# production/compose.yml. Credenciais do banco ficam em secrets/db.env:
#   MOODLE_DBUSER=...
#   MOODLE_DBPASS=...
IMAGE_TAG=4.5.15-php8.3
MOODLE_CODE_DIR=/home/admin/moodle/code
MOODLE_URL=https://ivana.academy
MOODLE_DBTYPE=mariadb
MOODLE_DBHOST=db.exemplo.interno
MOODLE_DBNAME=moodle
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443
CRON_ENABLED=true
# Opcionais
#MOODLE_MEM_LIMIT=700m
#MOODLE_PIDS_LIMIT=256
#MOODLE_DATA_HOST=/home/admin/moodledata
