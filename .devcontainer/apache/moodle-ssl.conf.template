<VirtualHost *:443>
    ServerAdmin callme@leodg.dev

    ServerName localhost
    ServerAlias ${MOODLE_URL_CLEAN}

    DocumentRoot ${APACHE_DOCUMENT_ROOT}

    SSLEngine on
    SSLCertificateFile    ${CERT_PATH}
    SSLCertificateKeyFile ${KEY_PATH}

	<FilesMatch "\.(?:cgi|shtml|phtml|php)$">
		SSLOptions +StdEnvVars
	</FilesMatch>
	<Directory /usr/lib/cgi-bin>
		SSLOptions +StdEnvVars
	</Directory>

	<Directory "/var/www/html">
		Options FollowSymLinks
		AllowOverride All
		Require all granted
	</Directory>

	# Caminhos internos -> 404 (admin/cli/checks.php -t security: core_publicpaths)
	# https://docs.moodle.org/405/en/Installing_Moodle#Set_up_your_server
	RedirectMatch 404 "/\.(?!well-known/)"
	RedirectMatch 404 "/(vendor|node_modules)/"
	RedirectMatch 404 "/(tests/behat|behat|fixtures)/"
	RedirectMatch 404 "/composer\.(json|lock)$"
	RedirectMatch 404 "/package(-lock)?\.json$"
	RedirectMatch 404 "/(environment|install)\.xml$"
	RedirectMatch 404 "/phpunit\.xml(\.dist)?$"
	RedirectMatch 404 "(?i)/[^/]*readme[^/]*$"
	RedirectMatch 404 "/(upgrade\.txt|UPGRADING\.md|UPGRADING-CURRENT\.md|CHANGES\.md)$"

	# SEO: paginas de sistema fora do Google (Search Console 11/2026 mostrou
	# politicas, dataprivacy, signup e switchdevice indexados). O local_seo
	# tambem marca noindex no HTML; aqui cobre redirects e respostas nao-HTML.
	<LocationMatch "^/(admin/|login/(forgot_password|signup|confirm)\.php|theme/switchdevice\.php|lib/requirejs\.php|user/|message/|calendar/|badges/|blog/|search/|r\.php)">
		Header always set X-Robots-Tag "noindex, follow"
	</LocationMatch>

    ErrorLog ${APACHE_LOG_DIR}/moodle_error.log
    CustomLog ${APACHE_LOG_DIR}/moodle_access.log combined
</VirtualHost>
